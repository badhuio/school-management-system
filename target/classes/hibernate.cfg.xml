        <!-- Register entity classes -->
        <mapping class="com.example.entity.Student"/>
        <mapping class="com.example.entity.Classes"/>
        <mapping class="com.example.entity.Fees"/>
        
       
        
    </session-factory>
</hibernate-configuration>
